<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign Up | VeriFolio</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #4F46E5;
            --primary-hover: #4338CA;
            --primary-light: #6366F1;
            --navy: #0F172A;
            --navy-2: #1E1B4B;
            --bg: #FFFFFF;
            --field: #F8FAFC;
            --track: #F1F5F9;
            --border: #E2E8F0;
            --text: #0F172A;
            --muted: #64748B;
            --muted-2: #94A3B8;
            --success: #10B981;
            --danger: #F43F5E;
            --ease-out: cubic-bezier(.22, 1, .36, 1);
            --ease-spring: cubic-bezier(.34, 1.56, .64, 1);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            -webkit-font-smoothing: antialiased;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg);
            color: var(--text);
            overflow-x: hidden;
        }

        h1, h2, h3 {
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-weight: 800;
            letter-spacing: -0.02em;
        }

        .label-sm {
            display: block;
            font-size: 10px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: .08em;
            color: var(--muted-2);
            margin-bottom: 6px;
            transition: color 150ms var(--ease-out);
        }

        /* --- Layout --- */
        .split-screen {
            display: flex;
            min-height: 100vh;
            width: 100%;
        }

        /* Left Panel */
        .brand-panel {
            flex: 1;
            background: linear-gradient(135deg, #0F172A 0%, #1E1B4B 55%, #1E2250 100%);
            position: relative;
            padding: 56px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            color: white;
            overflow: hidden;
            animation: fadeIn 650ms var(--ease-out) both;
        }

        .brand-panel::before {
            content: '';
            position: absolute;
            inset: 0;
            background: repeating-linear-gradient(0deg, transparent, transparent 1px, rgba(255,255,255,0.03) 1px, rgba(255,255,255,0.03) 2px);
            pointer-events: none;
        }

        .brand-glow {
            position: absolute;
            width: 600px;
            height: 600px;
            background: radial-gradient(circle, rgba(79, 70, 229, 0.15) 0%, transparent 70%);
            bottom: -200px;
            right: -200px;
            z-index: 0;
            animation: glowDrift 14s infinite alternate ease-in-out;
            pointer-events: none;
        }

        .logo-group {
            display: flex;
            align-items: center;
            gap: 12px;
            z-index: 1;
        }

        .logo-square {
            width: 36px;
            height: 36px;
            background: #5B50F0;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .logo-text {
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-weight: 700;
            font-size: 22px;
        }

        .brand-content {
            max-width: 480px;
            z-index: 1;
        }

        .brand-h1 {
            font-size: clamp(36px, 3.4vw, 46px);
            line-height: 1.15;
            margin-bottom: 28px;
        }

        .highlight-indigo {
            color: var(--primary-light);
            position: relative;
            display: inline-block;
        }

        .shimmer {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
            transform: translateX(-100%);
            animation: shimmerSweep 1.5s var(--ease-out) forwards;
            animation-delay: 1.2s;
            pointer-events: none;
        }

        .brand-p {
            font-size: 16px;
            color: rgba(255,255,255,0.6);
            line-height: 1.6;
            max-width: 400px;
            margin-bottom: 40px;
        }

        .benefit-list {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .benefit-item {
            display: flex;
            align-items: center;
            gap: 16px;
            font-size: 15px;
            color: rgba(255,255,255,0.9);
            transform: translateY(18px);
            opacity: 0;
            animation: fadeUp 500ms var(--ease-out) forwards;
        }

        .benefit-icon {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: rgba(255,255,255,0.08);
            border: 1px solid rgba(255,255,255,0.08);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            transition: all 200ms;
        }

        .benefit-item:hover .benefit-icon {
            background: rgba(255,255,255,0.15);
            transform: translateY(-2px);
        }

        .copyright {
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: .1em;
            color: rgba(255,255,255,0.55);
            z-index: 1;
        }

        /* Right Panel */
        .form-panel {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0 24px;
            background: white;
        }

        .form-container {
            width: 100%;
            max-width: 400px;
        }

        .form-header {
            text-align: center;
            margin-bottom: 28px;
        }

        .form-header h2 {
            font-size: 28px;
            color: var(--navy);
            margin-bottom: 6px;
        }

        .form-header p {
            font-size: 14.5px;
            color: var(--muted);
        }

        /* Role Toggle */
        .role-toggle {
            position: relative;
            height: 48px;
            background: var(--track);
            border-radius: var(--radius-pill);
            padding: 4px;
            display: flex;
            margin-bottom: 24px;
            user-select: none;
        }

        .role-btn {
            flex: 1;
            border: none;
            background: none;
            font-family: 'Inter', sans-serif;
            font-size: 13.5px;
            font-weight: 600;
            cursor: pointer;
            z-index: 2;
            transition: color 300ms var(--ease-out);
            color: var(--muted);
        }

        .role-btn.active {
            color: var(--navy);
        }

        .role-indicator {
            position: absolute;
            top: 4px;
            left: 4px;
            width: calc(50% - 4px);
            height: calc(100% - 8px);
            background: white;
            border-radius: var(--radius-pill);
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
            transition: transform 300ms var(--ease-out);
            z-index: 1;
        }

        .role-toggle[data-role="recruiter"] .role-indicator {
            transform: translateX(100%);
        }

        /* Form Fields */
        .form-group {
            margin-bottom: 16px;
            position: relative;
            animation: fadeUp 500ms var(--ease-out) both;
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            margin-bottom: 16px;
        }

        .field-wrapper {
            display: flex;
            flex-direction: column;
            position: relative;
        }

        .input-field {
            height: 46px;
            border-radius: var(--radius-pill);
            background: var(--field);
            border: 1px solid var(--border);
            padding: 0 18px;
            font-family: 'Inter', sans-serif;
            font-size: 14px;
            transition: all 150ms var(--ease-out);
            width: 100%;
            outline: none;
        }

        .input-field:focus {
            border-color: var(--primary);
            background: white;
            box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.12);
        }

        .input-field:focus + .label-sm {
            color: var(--primary);
        }

        /* Select Customization */
        .select-wrapper {
            position: relative;
        }

        .input-select {
            appearance: none;
            cursor: pointer;
        }

        .select-chevron {
            position: absolute;
            right: 18px;
            top: 50%;
            transform: translateY(-50%);
            pointer-events: none;
            transition: transform 200ms var(--ease-out);
            color: var(--muted);
        }

        .input-field:focus + .select-chevron {
            transform: translateY(-50%) rotate(180deg);
        }

        /* Password Field */
        .password-wrapper {
            position: relative;
        }

        .password-toggle {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            cursor: pointer;
            color: var(--muted);
            padding: 4px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* Strength Meter */
        .strength-container {
            margin-top: 12px;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .meter-bar {
            display: flex;
            gap: 4px;
        }

        .meter-segment {
            height: 4px;
            flex: 1;
            background: var(--track);
            border-radius: var(--radius-pill);
            transition: background 300ms var(--ease-out);
        }

        .meter-hint {
            font-size: 11px;
            color: var(--muted);
        }

        /* Errors */
        .error-msg {
            position: absolute;
            left: 18px;
            font-size: 12px;
            color: var(--danger);
            margin-top: 4px;
            opacity: 0;
            transform: translateY(-6px);
            transition: all 200ms var(--ease-out);
            pointer-events: none;
            white-space: nowrap;
        }

        .field-error .input-field {
            border-color: var(--danger);
            animation: shake 300ms var(--ease-out);
        }

        .field-error .error-msg {
            opacity: 1;
            transform: translateY(0);
        }

        .success-check {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--success);
            opacity: 0;
            transition: opacity 200ms;
            pointer-events: none;
        }

        .field-success .success-check {
            opacity: 1;
        }

        /* Terms & Submit */
        .terms-text {
            text-align: center;
            font-size: 11.5px;
            color: var(--muted);
            margin-top: 20px;
            line-height: 1.5;
        }

        .terms-link {
            color: var(--primary);
            font-weight: 600;
            text-decoration: none;
        }

        .submit-btn {
            width: 100%;
            height: 52px;
            border-radius: var(--radius-pill);
            background: var(--navy);
            color: white;
            font-size: 15px;
            font-weight: 700;
            cursor: pointer;
            transition: all 200ms var(--ease-out);
            border: none;
            margin-top: 16px;
            box-shadow: 0 14px 28px rgba(15, 23, 42, 0.22);
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            overflow: hidden;
        }

        .submit-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 18px 32px rgba(15, 23, 42, 0.3);
        }

        .submit-btn:active {
            transform: scale(0.97);
        }

        .submit-btn::after {
            content: '';
            position: absolute;
            top: -50%;
            left: -100%;
            width: 100%;
            height: 200%;
            background: linear-gradient(45deg, transparent, rgba(255,255,255,0.1), transparent);
            transform: rotate(45deg);
            transition: 0.6s;
        }

        .submit-btn:hover::after {
            left: 150%;
        }

        /* Divider & Social */
        .divider {
            display: flex;
            align-items: center;
            gap: 16px;
            margin: 24px 0;
        }

        .divider-line {
            flex: 1;
            height: 1px;
            background: var(--border);
        }

        .divider-text {
            font-size: 10px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: .1em;
            color: var(--muted);
        }

        .social-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }

        .social-btn {
            height: 46px;
            border-radius: var(--radius-pill);
            background: white;
            border: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            font-size: 13.5px;
            font-weight: 600;
            cursor: pointer;
            transition: all 200ms var(--ease-out);
            color: var(--text);
        }

        .social-btn:hover {
            background: var(--field);
            border-color: var(--primary);
        }

        .footer-link {
            text-align: center;
            margin-top: 28px;
            font-size: 13.5px;
            color: var(--muted);
        }

        .footer-link a {
            color: var(--primary);
            font-weight: 600;
            text-decoration: none;
        }

        /* Loading States */
        .spinner {
            width: 18px;
            height: 18px;
            border: 2px solid rgba(255,255,255,0.3);
            border-top-color: white;
            border-radius: 50%;
            animation: spin 0.6s linear infinite;
        }

        /* Toast */
        .toast {
            position: fixed;
            bottom: 24px;
            right: 24px;
            background: var(--navy);
            color: white;
            padding: 16px 24px;
            border-radius: 16px;
            box-shadow: 0 12px 32px rgba(0,0,0,0.2);
            z-index: 3000;
            transform: translateX(120%);
            transition: transform 300ms var(--ease-out);
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .toast.show {
            transform: translateX(0);
        }

        .toast-progress {
            position: absolute;
            bottom: 0;
            left: 0;
            height: 2px;
            background: var(--primary);
            width: 100%;
            transform-origin: left;
            animation: shrink 3s linear forwards;
        }

        /* --- Animations --- */
        @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
        @keyframes fadeUp {
            from { opacity: 0; transform: translateY(18px); }
            to { opacity: 1; transform: translateY(0); }
        }
        @keyframes shimmerSweep { 0% { transform: translateX(-100%); } 100% { transform: translateX(100%); } }
        @keyframes glowDrift {
            0% { transform: translate(0, 0) scale(1); }
            100% { transform: translate(40px, 40px) scale(1.1); }
        }
        @keyframes bob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }
        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            25% { transform: translateX(-6px); }
            75% { transform: translateX(6px); }
        }
        @keyframes spin { to { transform: rotate(360deg); } }
        @keyframes shrink { from { transform: scaleX(1); } to { transform: scaleX(0); } }

        /* --- Responsive --- */
        @media (max-width: 900px) {
            .split-screen { flex-direction: column; }
            .brand-panel {
                padding: 28px 24px;
                flex: 0 0 auto;
                align-items: center;
                text-align: center;
            }
            .brand-content { display: none; }
            .logo-group { margin-bottom: 20px; }
            .brand-h1 { font-size: 28px; }
            .copyright { display: none; }
            .form-panel { padding: 40px 24px; }
        }

        @media (max-width: 480px) {
            .form-row { grid-template-columns: 1fr; }
            .social-grid { grid-template-columns: 1fr; }
        }

        @media (prefers-reduced-motion: reduce) {
            * { animation: none !important; transition: none !important; }
        }
    </style>
</head>
<body>

    <div class="split-screen">
        <!-- Left Panel -->
        <div class="brand-panel">
            <div class="brand-glow"></div>
            <div class="logo-group">
                <div class="logo-square">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="white" stroke="none"><path d="M12 2L3 7v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V7l-9-5z"/></svg>
                </div>
                <span class="logo-text">VeriFolio</span>
            </div>

            <div class="brand-content">
                <h1 class="brand-h1">
                    Join the <span class="highlight-indigo">Elite Tier<span class="shimmer"></span></span> of<br>student talent.
                </h1>
                <p class="brand-p">Create your verified portfolio and connect with recruiters who value proven expertise.</p>
                <ul class="benefit-list">
                    <li class="benefit-item" style="--i: 1">
                        <div class="benefit-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                        </div>
                        Free forever for students
                    </li>
                    <li class="benefit-item" style="--i: 2">
                        <div class="benefit-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                        </div>
                        Independent skill auditing
                    </li>
                    <li class="benefit-item" style="--i: 3">
                        <div class="benefit-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                        </div>
                        Global credential visibility
                    </li>
                </ul>
            </div>

            <div class="copyright">© 2024 VERIFOLIO SYSTEM</div>
        </div>

        <!-- Right Panel -->
        <div class="form-panel">
            <div class="form-container">
                <div class="form-header">
                    <h2 id="formTitle">Create Account</h2>
                    <p id="form-subtitle">Start your journey to a verified professional identity.</p>
                </div>

                <div class="role-toggle" id="roleToggle" role="tablist" data-role="student">
                    <div class="role-indicator"></div>
                    <button class="role-btn active" role="tab" aria-selected="true" data-role="student">I'm a Student</button>
                    <button class="role-btn" role="tab" aria-selected="false" data-role="recruiter">I'm a Recruiter</button>
                </div>

                <form id="signupForm" novalidate>
                    <div class="form-row">
                        <div class="field-wrapper">
                            <label for="firstName" class="label-sm">First Name</label>
                            <input type="text" id="firstName" name="firstName" class="input-field" placeholder="Aryan" required>
                            <span class="error-msg">Required (2+ chars)</span>
                            <div class="success-check"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></div>
                        </div>
                        <div class="field-wrapper">
                            <label for="lastName" class="label-sm">Last Name</label>
                            <input type="text" id="lastName" name="lastName" class="input-field" placeholder="Yadav" required>
                            <span class="error-msg">Required (2+ chars)</span>
                            <div class="success-check"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></div>
                        </div>
                    </div>

                    <div class="field-wrapper form-group">
                        <label for="email" class="label-sm" id="emailLabel">College Email</label>
                        <input type="email" id="email" name="email" class="input-field" placeholder="aryan@nit.edu" required>
                        <span class="error-msg" id="emailError">Invalid college email</span>
                        <div class="success-check"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></div>
                    </div>

                    <div class="field-wrapper form-group" id="institutionWrapper">
                        <label for="institution" class="label-sm" id="instLabel">College Name</label>
                        <div class="select-wrapper" id="instInputContainer">
                            <select id="institution" name="institution" class="input-field input-select" required>
                                <option value="" disabled selected>Select your institution</option>
                                <option value="nit">National Institute of Technology (NIT)</option>
                                <option value="iit">Indian Institute of Technology (IIT)</option>
                                <option value="bit">Birla Institute of Technology (BIT)</option>
                                <option value="vit">Vellore Institute of Technology (VIT)</option>
                                <option value="other">Other</option>
                            </select>
                            <div class="select-chevron">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                            </div>
                        </div>
                        <span class="error-msg">Please select an institution</span>
                        <div class="success-check"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></div>
                    </div>

                    <div class="field-wrapper form-group">
                        <label for="password" class="label-sm">Password</label>
                        <div class="password-wrapper">
                            <input type="password" id="password" name="password" class="input-field" placeholder="••••••••" required>
                            <button type="button" class="password-toggle" id="togglePass">
                                <svg class="eye-open" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                            </button>
                        </div>
                        <span class="error-msg">Minimum 8 characters required</span>
                        <div class="success-check"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></div>
                    </div>

                    <div class="strength-container">
                        <div class="meter-bar">
                            <div class="meter-segment"></div>
                            <div class="meter-segment"></div>
                            <div class="meter-segment"></div>
                            <div class="meter-segment"></div>
                        </div>
                        <span class="meter-hint">Use 8+ characters with a number and a symbol.</span>
                    </div>

                    <p class="terms-text">
                        By clicking "Create Account", you agree to our <a href="#" class="terms-link">Terms of Service</a> and <a href="#" class="terms-link">Privacy Policy</a>.
                    </p>

                    <button type="submit" class="submit-btn" id="submitBtn">
                        <span class="btn-text">Create Account</span>
                        <div class="spinner" style="display: none;"></div>
                    </button>
                </form>

                <div class="divider">
                    <div class="divider-line"></div>
                    <span class="divider-text">OR SIGN UP WITH</span>
                    <div class="divider-line"></div>
                </div>

                <div class="social-grid">
                    <button class="social-btn" id="socialGoogle">
                        <svg width="16" height="16" viewBox="0 0 24 24"><path fill="#EA4335" d="M12 5.6c-1.1 0-2 .9-2 2v2h4v-2c0-1.1-.9-2-2-2z"/><path fill="#FBBC05" d="M12 18.4c1.1 0 2-.9 2-2v-2h-4v2c0 1.1.9 2 2 2z"/><path fill="#34A853" d="M18.4 12c0-1.1-.9-2-2-2h-2v4h2c1.1 0 2-.9 2-2z"/><path fill="#4285F4" d="M6 12c0 1.1.9 2 2 2h2v-4h-2c-1.1 0-2 .9-2 2z"/><path fill="#4285F4" d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2z"/></svg>
                        Google
                    </button>
                    <button class="social-btn" id="socialGithub">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.412-4.033-1.412-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.216 1.835 2.398 1.079 2.992.838.107-.775.418-1.305.932-1.698-1.265-.303-2.545-1.297-2.545-2.884 0-2.515 1.783-4.526 4.064-4.526 1.249 0 2.343.853 2.75 2.112.083.613.356 1.204.628 1.563.398.347.9S3.333 10.75 3.333 10.75z"/></svg>
                        GitHub
                    </button>
                </div>

                <div class="footer-link">
                    Already have an account? <a href="signin.html" style="color: var(--primary); font-weight: 600; text-decoration: none;">Sign in</a>
                </div>
            </div>
        </div>
    </div>

    <div class="toast" id="toast">
        <div class="toast-progress"></div>
        <span id="toast-msg">Welcome to VeriFolio!</span>
    </div>

    <script>
        (function() {
            // --- State ---
            let currentRole = 'student';
            const state = {
                formData: { firstName: '', lastName: '', email: '', institution: '', password: '' },
                errors: new Set(),
                successes: new Set()
            };

            const elements = {
                roleToggle: document.getElementById('roleToggle'),
                roleBtns: document.querySelectorAll('.role-btn'),
                form: document.getElementById('signupForm'),
                submitBtn: document.getElementById('submitBtn'),
                toast: document.getElementById('toast'),
                toastMsg: document.getElementById('toast-msg'),
                emailLabel: document.getElementById('emailLabel'),
                instLabel: document.getElementById('instLabel'),
                instWrapper: document.getElementById('institutionWrapper'),
                subtitle: document.getElementById('form-subtitle'),
                passwordInput: document.getElementById('password'),
                togglePass: document.getElementById('togglePass'),
                meterSegments: document.querySelectorAll('.meter-segment')
            };

            // --- Initialization ---
            const init = () => {
                handleUrlRole();
                setupRoleSwitch();
                setupValidation();
                setupPasswordToggle();
                setupSubmit();
                setupSocial();
                runEntrances();
            };

            const handleUrlRole = () => {
                const params = new URLSearchParams(window.location.search);
                const role = params.get('role') || localStorage.getItem('vf_role') || 'student';
                setRole(role);
            };

            const setRole = (role) => {
                currentRole = role;
                localStorage.setItem('vf_role', role);
                elements.roleToggle.dataset.role = role;

                elements.roleBtns.forEach(btn => {
                    const isActive = btn.dataset.role === role;
                    btn.classList.toggle('active', isActive);
                    btn.setAttribute('aria-selected', isActive);
                });

                // UI Transition
                elements.subtitle.innerText = role === 'student'
                    ? "Start your journey to a verified professional identity."
                    : "Start discovering independently verified talent.";

                elements.emailLabel.innerText = role === 'student' ? "College Email" : "Work Email";
                elements.instLabel.innerText = role === 'student' ? "College Name" : "Company";

                const emailInput = document.getElementById('email');
                emailInput.placeholder = role === 'student' ? "aryan@nit.edu" : "sarah@company.com";

                const instContainer = document.getElementById('instInputContainer');
                if (role === 'recruiter') {
                    instContainer.innerHTML = `<input type="text" id="institution" name="institution" class="input-field" placeholder="Company name" required>`;
                } else {
                    instContainer.innerHTML = `
                        <select id="institution" name="institution" class="input-field input-select" required>
                            <option value="" disabled selected>Select your institution</option>
                            <option value="nit">National Institute of Technology (NIT)</option>
                            <option value="iit">Indian Institute of Technology (IIT)</option>
                            <option value="bit">Birla Institute of Technology (BIT)</option>
                            <option value="vit">Vellore Institute of Technology (VIT)</option>
                            <option value="other">Other</option>
                        </select>
                        <div class="select-chevron">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                        </div>`;
                }
            };

            const setupRoleSwitch = () => {
                elements.roleToggle.addEventListener('click', (e) => {
                    const btn = e.target.closest('.role-btn');
                    if (btn) setRole(btn.dataset.role);
                });
            };

            const setupPasswordToggle = () => {
                elements.togglePass.addEventListener('click', () => {
                    const type = elements.passwordInput.type === 'password' ? 'text' : 'password';
                    elements.passwordInput.type = type;
                });
            };

            // --- Validation Logic ---
            const validateField = (id, value) => {
                let isValid = true;
                let msg = "";

                if (id === 'firstName' || id === 'lastName') {
                    if (value.trim().length < 2) {
                        isValid = false;
                        msg = "Required (2+ chars)";
                    }
                } else if (id === 'email') {
                    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
                    if (!emailRegex.test(value)) {
                        isValid = false;
                        msg = "Enter a valid email";
                    } else if (currentRole === 'student' && !value.match(/\.(edu|ac\.in)$/)) {
                        isValid = false;
                        msg = "Please use your college email";
                    }
                } else if (id === 'institution') {
                    if (!value.trim()) {
                        isValid = false;
                        msg = "Institution required";
                    }
                } else if (id === 'password') {
                    if (value.length < 8) {
                        isValid = false;
                        msg = "Minimum 8 characters required";
                    }
                }

                updateFieldUI(id, isValid, msg);
                return isValid;
            };

            const updateFieldUI = (id, isValid, msg) => {
                const field = document.getElementById(id);
                if (!field) return;
                const wrapper = field.closest('.field-wrapper');
                const errorEl = wrapper.querySelector('.error-msg');
                const successEl = wrapper.querySelector('.success-check');

                if (!isValid) {
                    wrapper.classList.add('field-error');
                    wrapper.classList.remove('field-success');
                    if (errorEl) errorEl.innerText = msg;
                    state.errors.add(id);
                } else {
                    wrapper.classList.remove('field-error');
                    wrapper.classList.add('field-success');
                    state.errors.delete(id);
                }
            };

            const updateStrength = (pass) => {
                let score = 0;
                if (pass.length >= 8) score++;
                if (/[A-Z]/.test(pass)) score++;
                if (/[0-9]/.test(pass)) score++;
                if (/[^A-Za-z0-9]/.test(pass)) score++;

                const colors = ['var(--danger)', 'var(--warning)', 'var(--warning)', 'var(--success)'];
                elements.meterSegments.forEach((seg, i) => {
                    seg.style.background = i < score ? colors[i] : 'var(--track)';
                });
            };

            const setupValidation = () => {
                elements.form.addEventListener('blur', (e) => {
                    if (e.target.classList.contains('input-field')) {
                        validateField(e.target.id, e.target.value);
                    }
                }, true);

                elements.passwordInput.addEventListener('input', (e) => {
                    updateStrength(e.target.value);
                });
            };

            const setupSubmit = () => {
                elements.form.addEventListener('submit', async (e) => {
                    e.preventDefault();
                    const inputs = elements.form.querySelectorAll('input, select');
                    let firstInvalid = null;

                    inputs.forEach(input => {
                        const valid = validateField(input.id, input.value);
                        if (!valid && !firstInvalid) firstInvalid = input;
                    });

                    if (firstInvalid) {
                        firstInvalid.focus();
                        return;
                    }

                    // Submit Flow
                    const btnText = elements.submitBtn.querySelector('.btn-text');
                    const spinner = elements.submitBtn.querySelector('.spinner');

                    elements.submitBtn.disabled = true;
                    btnText.style.opacity = '0';
                    spinner.style.display = 'block';

                    await new Promise(r => setTimeout(r, 1200));

                    spinner.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';
                    spinner.style.animation = 'none';

                    showToast(`Welcome to VeriFolio, ${document.getElementById('firstName').value}!`);

                    setTimeout(() => {
                        window.location.href = currentRole === 'student' ? 'dashboard.html' : 'recruiter.html';
                    }, 1500);
                });
            };

            const setupSocial = () => {
                const handleSocial = (provider) => {
                    const btn = event.currentTarget;
                    const originalText = btn.innerText;
                    btn.innerHTML = '<div class="spinner"></div>';
                    setTimeout(() => {
                        btn.innerHTML = originalText;
                        showToast(`Social sign-up with ${provider} is a demo in this build.`);
                    }, 1000);
                };
                document.getElementById('socialGoogle').addEventListener('click', () => handleSocial('Google'));
                document.getElementById('socialGithub').addEventListener('click', () => handleSocial('GitHub'));
            };

            const showToast = (msg) => {
                elements.toastMsg.innerText = msg;
                elements.toast.classList.add('show');
                setTimeout(() => elements.toast.classList.remove('show'), 3000);
            };

            const runEntrances = () => {
                const h1 = document.querySelector('.brand-h1');
                const text = h1.innerText;
                h1.innerHTML = text.split(' ').map(w => `<span style="display:inline-block; opacity:0; transform:translateY(18px); animation: fadeUp 500ms var(--ease-out) forwards">${w} </span>`).join('');

                document.querySelectorAll('.benefit-item').forEach((el, i) => {
                    el.style.animationDelay = `${0.6 + (i * 0.09)}s`;
                });

                document.querySelectorAll('.form-group, .form-row').forEach((el, i) => {
                    el.style.animationDelay = `${0.4 + (i * 0.06)}s`;
                });
            };

            init();
        })();
    </script>
</body>
</html>
